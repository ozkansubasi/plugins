<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_NUMISTRCANONICAL</name>
    <author>NumisTR</author>
    <creationDate>November 2026</creationDate>
    <copyright>Copyright (C) 2026 NumisTR. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>info@numistr.org</authorEmail>
    <authorUrl>https://www.numistr.org</authorUrl>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_NUMISTRCANONICAL_XML_DESCRIPTION</description>

    <files>
        <filename plugin="numistrcanonical">numistrcanonical.php</filename>
        <filename>index.html</filename>
        <folder>language</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_system_numistrcanonical.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_numistrcanonical.sys.ini</language>
        <language tag="tr-TR">language/tr-TR/plg_system_numistrcanonical.ini</language>
        <language tag="tr-TR">language/tr-TR/plg_system_numistrcanonical.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="domain" type="url" label="PLG_SYSTEM_NUMISTRCANONICAL_DOMAIN" description="PLG_SYSTEM_NUMISTRCANONICAL_DOMAIN_DESC" default="https://www.numistr.org" filter="url" />
                <field name="keep_params" type="text" label="PLG_SYSTEM_NUMISTRCANONICAL_KEEP" description="PLG_SYSTEM_NUMISTRCANONICAL_KEEP_DESC" default="start,limitstart" />
            </fieldset>
        </fields>
    </config>
</extension>
