<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_NUMISTRAUTH</name>
    <author>NumisTR</author>
    <creationDate>August 2026</creationDate>
    <copyright>Copyright (C) 2026 NumisTR. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>info@numistr.org</authorEmail>
    <authorUrl>https://www.numistr.org</authorUrl>
    <version>1.0.1</version>
    <description>PLG_SYSTEM_NUMISTRAUTH_XML_DESCRIPTION</description>

    <files>
        <filename plugin="numistrauth">numistrauth.php</filename>
        <folder>src</folder>
        <folder>language</folder>
    </files>

    <languages>
        <language tag="en-GB">language/en-GB/plg_system_numistrauth.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_numistrauth.sys.ini</language>
        <language tag="tr-TR">language/tr-TR/plg_system_numistrauth.ini</language>
        <language tag="tr-TR">language/tr-TR/plg_system_numistrauth.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="auth0_domain" type="text" label="PLG_SYSTEM_NUMISTRAUTH_DOMAIN_LABEL" description="PLG_SYSTEM_NUMISTRAUTH_DOMAIN_DESC" default="dev-ja5k8sumb7005j4n.us.auth0.com" required="true" />
                <field name="client_id" type="text" label="PLG_SYSTEM_NUMISTRAUTH_CLIENT_ID_LABEL" description="PLG_SYSTEM_NUMISTRAUTH_CLIENT_ID_DESC" required="true" />
                <field name="client_secret" type="password" label="PLG_SYSTEM_NUMISTRAUTH_CLIENT_SECRET_LABEL" description="PLG_SYSTEM_NUMISTRAUTH_CLIENT_SECRET_DESC" required="true" filter="raw" autocomplete="off" />
                <field name="connection" type="text" label="PLG_SYSTEM_NUMISTRAUTH_CONNECTION_LABEL" description="PLG_SYSTEM_NUMISTRAUTH_CONNECTION_DESC" />
                <field name="require_email_verified" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_NUMISTRAUTH_VERIFIED_LABEL" description="PLG_SYSTEM_NUMISTRAUTH_VERIFIED_DESC" default="1">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="remember_me" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_NUMISTRAUTH_REMEMBER_LABEL" default="1">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="auth0_logout" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_NUMISTRAUTH_AUTH0_LOGOUT_LABEL" description="PLG_SYSTEM_NUMISTRAUTH_AUTH0_LOGOUT_DESC" default="1">
                    <option value="0">JNO</option><option value="1">JYES</option>
                </field>
                <field name="pro_group_id" type="number" label="PLG_SYSTEM_NUMISTRAUTH_PRO_GROUP_LABEL" default="10" />
            </fieldset>
            <fieldset name="redirects" label="PLG_SYSTEM_NUMISTRAUTH_REDIRECTS">
                <field name="return_tr" type="text" label="PLG_SYSTEM_NUMISTRAUTH_RETURN_TR_LABEL" default="/tr/hesabim" />
                <field name="return_en" type="text" label="PLG_SYSTEM_NUMISTRAUTH_RETURN_EN_LABEL" default="/en/my-account" />
                <field name="error_tr" type="text" label="PLG_SYSTEM_NUMISTRAUTH_ERROR_TR_LABEL" default="/tr/abonelikler" />
                <field name="error_en" type="text" label="PLG_SYSTEM_NUMISTRAUTH_ERROR_EN_LABEL" default="/en/plans" />
            </fieldset>
        </fields>
    </config>
</extension>
